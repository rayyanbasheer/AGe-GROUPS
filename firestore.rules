rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required, max 100 chars)
    //   - category: string (required, max 50 chars)
    //   - status: string (required, max 50 chars)
    //   - location: string (required, max 100 chars)
    //   - description: string (required, max 1000 chars)
    //   - imageUrl: string (required, valid URL)
    //   - createdAt: timestamp (required)
    //
    // Collection: leads
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, max 100 chars)
    //   - phone: string (required, max 20 chars)
    //   - message: string (required, max 2000 chars)
    //   - source: string (required, max 50 chars)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'rayyanbasheer02@gmail.com' && request.auth.token.email_verified == true;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidProject(data) {
      return hasOnlyAllowedFields(['title', 'category', 'status', 'location', 'description', 'imageUrl', 'createdAt']) &&
             hasRequiredFields(['title', 'category', 'status', 'location', 'description', 'imageUrl', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 50 &&
             data.location is string && data.location.size() > 0 && data.location.size() <= 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
             isValidUrl(data.imageUrl) &&
             data.createdAt is timestamp;
    }

    function isValidLead(data) {
      return hasOnlyAllowedFields(['name', 'phone', 'message', 'source', 'createdAt']) &&
             hasRequiredFields(['name', 'phone', 'message', 'source', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.source is string && data.source.size() > 0 && data.source.size() <= 50 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /projects/{projectId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidProject(request.resource.data);
      allow update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if isValidLead(request.resource.data);
      allow update: if false; // Leads cannot be updated
      allow delete: if isAdmin();
    }
  }
}
